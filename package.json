{
  "name": "@maxmilton/test-utils",
  "version": "0.0.17",
  "description": "Test utilities with support for Bun, CSS, stage1, and more",
  "bugs": "https://github.com/maxmilton/test-utils/issues",
  "license": "MIT",
  "author": "Max Milton <max@2okki.com>",
  "repository": "github:maxmilton/test-utils",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    "./css": {
      "types": "./dist/css.d.ts",
      "bun": "./src/css.ts",
      "default": "./dist/css.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "bun": "./src/dom.ts",
      "default": "./dist/dom.js"
    },
    "./extend": {
      "types": "./dist/extend.d.ts",
      "bun": "./src/extend.ts",
      "default": "./dist/extend.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "bun": "./src/html.ts",
      "default": "./dist/html.js"
    },
    "./spy": {
      "types": "./dist/spy.d.ts",
      "bun": "./src/spy.ts",
      "default": "./dist/spy.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.ts",
    "lint": "bun lint:fmt && bun lint:js && bun lint:ts",
    "lint:fmt": "oxfmt --check",
    "lint:js": "oxlint --format=stylish",
    "lint:ts": "tsc --noEmit",
    "test": "bun test --only-failures",
    "test:ci": "bun test --coverage --randomize --rerun-each=30"
  },
  "dependencies": {
    "@maxmilton/html-parser": "^0.0.13",
    "@types/stylis": "^4.2.7",
    "stylis": "^4.3.6"
  },
  "devDependencies": {
    "@maxmilton/oxlint-config": "0.0.8",
    "@types/bun": "1.3.14",
    "happy-dom": "20.11.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "stage1": "0.10.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "happy-dom": ">=14.0.0 <21.0.0"
  },
  "peerDependenciesMeta": {
    "happy-dom": {
      "optional": true
    }
  }
}
